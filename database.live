Table: accounts, Model: Account
Fields:
> id: string, primary key;
> connection_id: string, unique, nullable;
> displayName: string, default: "";
> neupid: string, default: "";
> displayImage: string, default: "";

Table: projects, Model: Project
Fields:
> id: UUID, primary key, default: gen_random_uuid();
> name: string;
> status: string;
> details: JSONB, nullable;
> createdOn: timestamp, default: current timestamp;

Table: roles, Model: Role
Fields:
> id: string, UUID, primary key;
> name: string;
> description: string;
> permissions: jsonb;

Table: access, Model: Access
Fields:
> id: string, UUID, primary key;
> accountId: string, references accounts.id;
> roleId: string, references roles.id;
> projectId: UUID, references projects.id;
> status: string;
> permittedOn: timestamp;

Table: party, Model: Party
Fields:
> id: UUID, primary key, default: gen_random_uuid();
> account_id: string, references accounts.id;
> projectId: UUID, references projects.id;
> name: string;
> type: string;
> taxinfo: JSON, nullable;

Table: party_contact, Model: PartyContact
Fields:
> id: string, UUID, primary key;
> party_id: UUID, references party.id;
> type: string;
> value: string;
> added_on: timestamp, default: current timestamp;
> details: JSON, nullable;

Table: party_payment_method, Model: PartyPaymentMethod
Fields:
> id: string, UUID, primary key;
> party_id: UUID, references party.id;
> type: string;
> value: string;
> added_on: timestamp, default: current timestamp;
> details: JSON, nullable;

Table: fin_book, Model: AssetGroup
Fields:
> id: string, UUID, primary key;
> name: string;
> type: AccountType enum, new rows limited to Bank or Cash;
> bank_name: string, nullable;
> branch: string, nullable;
> account_type: string, nullable;
> currency: string, account default currency or ALL for any currency;
> accountId: string, references accounts.id;
> projectId: UUID, references projects.id;
> createdAt: timestamp, default: current timestamp;

Table: fin_accounts_transactions, Model: FinAccountTransaction
Fields:
> id: UUID, primary key, default: gen_random_uuid();
> title: string;
> description: string, nullable;
> fin_account_id: string, references fin_book.id;
> party_id: UUID, references party.id, nullable;
> currency: string;
> amount: decimal(18,2);
> direction: string, values: in, out;
> status: enum(draft, active, reviewRequired), default: active;
> tags: JSONB, nullable;
> details: JSONB, nullable;
> activity_on: timestamp with time zone;

Table: fin_account, Model: FinAccount
Fields:
> id: string, UUID, primary key;
> profile_id: string;
> projectId: UUID, references projects.id;
> name: string;
> description: string, nullable;
> type: string;
> currency: string;
> is_multi_currency: boolean, default: false;
> status: string;
> notes: string, nullable;
> opened_on: timestamp, nullable;
> created_on: timestamp, default: current timestamp;

Table: transaction, Model: Transaction
Fields:
> id: string, UUID, primary key;
> organization_id: string, references accounts.id;
> projectId: UUID, references projects.id;
> transaction_type_id: string;
> title: string;
> description: string, nullable;
> transaction_date: timestamp;
> status: string;
> reference_number: string, nullable;
> external_reference: string, nullable;
> currency: string;
> final_amount: decimal, default: 0;
> created_by: string, nullable;
> created_at: timestamp, default: current timestamp;
> tags: JSON, nullable;
> notes: JSON, nullable;
> details: JSON, nullable;

Table: transaction_line, Model: TransactionLine
Fields:
> id: string, UUID, primary key;
> transaction_id: string, references transaction.id;
> line_type_id: string, nullable;
> title: string;
> description: string, nullable;
> reference_type: string, nullable;
> reference_id: string, nullable;
> currency: string;
> base_amount: decimal, default: 0;
> sort_order: int, default: 0;
> metadata: JSON, nullable;
> fin_book: string, references fin_book.id, nullable;
> fin_account: string, nullable;
> tags: JSON, nullable;
> details: JSON, nullable;

Table: Projection, Model: Projection
Fields:
> id: string, UUID, primary key;
> title: string;
> type: ProjectionType enum;
> certainty: ProjectionCertainty enum;
> amount: decimal;
> currency: string;
> date: timestamp;
> userId: string;
> projectId: string, references projects.id;
> status: ProjectionStatus enum;
> recipient: string, nullable;
> isRecurring: boolean, default: false;
> recurrence: ProjectionRecurrence enum;
> endsOn: timestamp, nullable;
> createdAt: timestamp, default: current timestamp;

Table: activity_stock, Model: ActivityStock
Fields:
> id: string, UUID, primary key;
> asset_group_id: string, references fin_book.id;
> stock_name: string;
> activity_type: ActivityStockType enum;
> cost: decimal;
> balance: decimal;
> recorded_on: timestamp;
> transaction_on: timestamp;

Table: documents, Model: Document
Fields:
> id: UUID, primary key, default: gen_random_uuid();
> project_id: UUID, references projects.id;
> type: varchar;
> created_at: timestamp, default: current timestamp;
> updated_at: timestamp, automatically updated;

Table: documents_relationships, Model: DocumentRelationship
Fields:
> id: UUID, primary key, default: gen_random_uuid();
> source_document_id: UUID, references documents.id;
> target_document_id: UUID, references documents.id;
> type: varchar;
> created_by: UUID;
> created_at: timestamp, default: current timestamp;

Table: documents_events, Model: DocumentEvent
Fields:
> id: UUID, primary key, default: gen_random_uuid();
> document_id: UUID, references documents.id;
> type: varchar;
> performed_by: UUID;
> data: JSONB;
> created_at: timestamp, default: current timestamp;

Table: documents_quotations, Model: DocumentQuotation
Fields:
> id: UUID, primary key, references documents.id;
> customer_id: UUID, references party.id;
> counter: integer;
> reference_number: varchar;
> subject: varchar;
> currency: varchar;
> exchange_rate: decimal(18,6);
> subtotal: decimal(18,2);
> discount_type: varchar;
> discount_value: decimal(18,2);
> discount_amount: decimal(18,2);
> tax_total: decimal(18,2);
> has_adjustments: boolean, default: false;
> total: decimal(18,2);
> status: varchar;
> date: date;
> expires: date;
> details: JSON, nullable;
> created_at: timestamp, default: current timestamp;
> updated_at: timestamp, automatically updated;

Table: documents_quotations_adjustments, Model: DocumentQuotationAdjustment
Fields:
> id: UUID, primary key, default: gen_random_uuid();
> quotation_id: UUID, references documents_quotations.id;
> adjustment_name: varchar;
> adjustment_value: decimal(18,2);
> created_at: timestamp, default: current timestamp;
> updated_at: timestamp, automatically updated;

Table: documents_adjustments_items, Model: DocumentAdjustmentItem
Fields:
> id: UUID, primary key, default: gen_random_uuid();
> quotation_id: UUID, references documents_quotations.id;
> product_id: UUID, nullable;
> name: varchar;
> description: varchar(128), nullable;
> quantity: decimal(18,2);
> unit: varchar;
> rate: decimal(18,2);
> discount_type: varchar;
> discount_value: decimal(18,2);
> discount_amount: decimal(18,2);
> tax_rate: decimal(8,4);
> tax_amount: decimal(18,2);
> amount: decimal(18,2);
> sort_index: integer;
> created_at: timestamp, default: current timestamp;
> updated_at: timestamp, automatically updated;

Table: documents_invoices, Model: Invoice
Fields:
> id: UUID, primary key, references documents.id;
> customer_id: UUID, references party.id;
> counter: integer;
> reference_number: varchar;
> subject: varchar;
> currency: varchar;
> exchange_rate: decimal(18,6);
> subtotal: decimal(18,2);
> discount_type: varchar;
> discount_value: decimal(18,2);
> discount_amount: decimal(18,2);
> tax_total: decimal(18,2);
> has_adjustments: boolean, default: false;
> total: decimal(18,2);
> status: varchar;
> date: date;
> due_date: date;
> details: JSON, nullable;
> created_at: timestamp, default: current timestamp;
> updated_at: timestamp, automatically updated;

Table: documents_invoices_adjustments, Model: InvoiceAdjustment
Fields:
> id: UUID, primary key, default: gen_random_uuid();
> invoice_id: UUID, references documents_invoices.id;
> adjustment_name: varchar;
> adjustment_value: decimal(18,2);
> created_at: timestamp, default: current timestamp;
> updated_at: timestamp, automatically updated;

Table: documents_invoices_items, Model: InvoiceItem
Fields:
> id: UUID, primary key, default: gen_random_uuid();
> invoice_id: UUID, references documents_invoices.id;
> product_id: UUID, nullable;
> name: varchar;
> description: varchar(128), nullable;
> quantity: decimal(18,2);
> unit: varchar;
> rate: decimal(18,2);
> discount_type: varchar;
> discount_value: decimal(18,2);
> discount_amount: decimal(18,2);
> tax_rate: decimal(8,4);
> tax_amount: decimal(18,2);
> amount: decimal(18,2);
> sort_index: integer;
> created_at: timestamp, default: current timestamp;
> updated_at: timestamp, automatically updated;

Table: documents_proformas, Model: Proforma
Fields:
> id: UUID, primary key, references documents.id;
> customer_id: UUID, references party.id;
> counter: integer;
> reference_number: varchar;
> subject: varchar;
> currency: varchar;
> exchange_rate: decimal(18,6);
> subtotal: decimal(18,2);
> discount_type: varchar;
> discount_value: decimal(18,2);
> discount_amount: decimal(18,2);
> tax_total: decimal(18,2);
> has_adjustments: boolean, default: false;
> total: decimal(18,2);
> status: varchar;
> date: date;
> due_date: date;
> details: JSON, nullable;
> created_at: timestamp, default: current timestamp;
> updated_at: timestamp, automatically updated;

Table: documents_proformas_adjustments, Model: ProformaAdjustment
Fields:
> id: UUID, primary key, default: gen_random_uuid();
> proforma_id: UUID, references documents_proformas.id;
> adjustment_name: varchar;
> adjustment_value: decimal(18,2);
> created_at: timestamp, default: current timestamp;
> updated_at: timestamp, automatically updated;

Table: documents_proformas_items, Model: ProformaItem
Fields:
> id: UUID, primary key, default: gen_random_uuid();
> proforma_id: UUID, references documents_proformas.id;
> product_id: UUID, nullable;
> name: varchar;
> description: varchar(128), nullable;
> quantity: decimal(18,2);
> unit: varchar;
> rate: decimal(18,2);
> discount_type: varchar;
> discount_value: decimal(18,2);
> discount_amount: decimal(18,2);
> tax_rate: decimal(8,4);
> tax_amount: decimal(18,2);
> amount: decimal(18,2);
> sort_index: integer;
> created_at: timestamp, default: current timestamp;
> updated_at: timestamp, automatically updated;
