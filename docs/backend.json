
{
  "entities": {
    "Account": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Account",
      "type": "object",
      "description": "Represents a financial account for a user or entity.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the account."
        },
        "type": {
          "type": "string",
          "description": "The type of the account (e.g., checking, savings, investment)."
        },
        "balance": {
          "type": "number",
          "description": "The current balance of the account."
        },
        "currency": {
          "type": "string",
          "description": "The currency of the account (e.g., USD, EUR, NPR)."
        },
        "userId": {
          "type": "string",
          "description": "The ID of the user who owns this account."
        }
      },
      "required": [
        "name",
        "type",
        "balance",
        "currency",
        "userId"
      ]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the NeupLedger application.",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier for the User, matching Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "description": "The user's chosen display name."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "accountId": {
          "type": "string",
          "description": "The name of the account/ledger the user is currently operating."
        }
      },
      "required": [
        "uid",
        "displayName",
        "accountId"
      ]
    },
    "Projection": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Projection",
      "type": "object",
      "description": "Represents a future income or expense projection.",
      "properties": {
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "Income",
            "Expense"
          ]
        },
        "certainty": {
          "type": "string",
          "enum": [
            "Fixed",
            "Probable",
            "Possible"
          ]
        },
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "userId": {
          "type": "string"
        },
        "status": {
            "type": "string",
            "enum": ["Active", "Canceled"]
        },
        "recipient": {
            "type": "string"
        },
        "isRecurring": {
            "type": "boolean"
        },
        "recurrence": {
            "type": "string",
            "enum": ["Once", "Daily", "Weekly", "Monthly", "Yearly", "Custom"]
        },
        "endsOn": {
            "type": "string",
            "format": "date"
        }
      },
      "required": [
        "title",
        "type",
        "certainty",
        "amount",
        "currency",
        "date",
        "userId",
        "status",
        "isRecurring",
        "recurrence"
      ]
    }
  },
  "auth": {
    "providers": [
      "anonymous"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profile information, keyed by their Firebase Auth UID."
    },
    "/users/{userId}/accounts/{accountId}": {
      "schema": {
        "$ref": "#/entities/Account"
      },
      "description": "Stores financial accounts for each user, ensuring data isolation."
    },
    "/projections/{projectionId}": {
      "schema": {
        "$ref": "#/entities/Projection"
      },
      "description": "Stores all financial projections in a single collection. The 'userId' field links a projection to a user."
    }
  }
}
