rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Rules for user profiles
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      // Users can create their own profile, ensuring the UID matches
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // Users can update their own profile
      allow update: if isOwner(userId);
      // Users can delete their own profile (consider if this is desired)
      allow delete: if isOwner(userId);
    }

    // Rules for user accounts
    match /users/{userId}/accounts/{accountId} {
      allow read, list, create, update, delete: if isOwner(userId);
    }

    // Rules for projections
    match /users/{userId}/projections/{projectionId} {
      allow read, list, create, update: if isOwner(userId);
      allow delete: if false; // Deleting projections is not allowed
    }
  }
}
