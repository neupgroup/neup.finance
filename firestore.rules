rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Rules for user profiles
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      // Users can create their own profile, ensuring the UID matches
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // Users can update their own profile
      allow update: if isOwner(userId);
      // Users can delete their own profile (consider if this is desired)
      allow delete: if isOwner(userId);
    }

    // Rules for user accounts
    match /users/{userId}/accounts/{accountId} {
      allow read, list, create, update, delete: if isOwner(userId);
    }

    // Rules for projections
    match /projections/{projectionId} {
      // User can read their own projections.
      allow read, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      // User can create a projection if they are the owner.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // User can update their own projection (e.g., to cancel it).
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Deleting projections is not allowed to maintain history.
      allow delete: if false;
    }
  }
}
