
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Rules for user profiles
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      // Users can create their own profile, ensuring the UID matches
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // Users can update their own profile
      allow update: if isOwner(userId);
      // Users can delete their own profile (consider if this is desired)
      allow delete: if isOwner(userId);
    }

    // Rules for user accounts
    match /users/{userId}/accounts/{accountId} {
      allow read, list, create, update, delete: if isOwner(userId);
    }

    // Rules for projections
    match /projections/{projectionId} {
      // User can read their own projections. Read is checked on each doc in a list.
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Allow list for signed in users. The 'read' rule above will secure the data.
      allow list: if isSignedIn();
      // User can create a projection if they are the owner.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Deleting projections is not allowed to maintain history.
      allow delete: if false;
    }

    // Rules for transactions
    match /transactions/{transactionId} {
      // Allow read, update, delete on documents the user owns.
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Allow list for signed-in users. The 'read' rule secures the documents.
      allow list: if isSignedIn();
      // Allow create if the new document's userId matches the user's uid.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // Rules for transaction lines subcollection
      match /lines/{lineId} {
        allow read, list, create, update, delete: if isSignedIn() && get(/databases/$(database)/documents/transactions/$(transactionId)).data.userId == request.auth.uid;
      }
    }
  }
}
