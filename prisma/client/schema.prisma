generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
}

/// ::neup.documentation::finance-ledger-schema
/// ::title Finance Ledger Schema
///
/// Defines the Prisma models for the finance ledger, including the physical
/// `fin_book` and `fin_account` tables used by transaction lines.
///
/// ::end

model Account {
  id                       String        @id
  connection_id            String?       @unique
  displayName              String        @default("")
  neupid                   String        @default("")
  displayImage             String        @default("")
  assetGroups              AssetGroup[]
  parties                  Party[]
  organizationTransactions Transaction[] @relation("TransactionOrganization")
  accesses                 Access[]

  @@map("accounts")
}

model Project {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  status       String
  createdOn    DateTime      @default(now())
  accesses     Access[]
  parties      Party[]
  books        AssetGroup[]
  transactions Transaction[]
  projections  Projection[]
  finAccounts  FinAccount[]
  documents    Document[]

  @@map("projects")
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String
  permissions Json     @db.JsonB
  accesses    Access[]

  @@map("roles")
}

model Access {
  id          String   @id @default(uuid())
  accountId   String
  roleId      String
  projectId   String   @db.Uuid
  status      String
  permittedOn DateTime
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([accountId, roleId, projectId])
  @@index([accountId])
  @@index([roleId])
  @@index([projectId])
  @@map("access")
}

model Party {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId              String                  @map("account_id")
  projectId              String                  @db.Uuid
  name                   String
  type                   String
  taxinfo                Json?
  account                Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project                Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contacts               PartyContact[]
  paymentMethods         PartyPaymentMethod[]
  quotations             DocumentQuotation[]
  invoices               Invoice[]
  proformas              Proforma[]
  finAccountTransactions FinAccountTransaction[]

  @@index([accountId])
  @@index([projectId])
  @@map("party")
}

model PartyContact {
  id      String   @id @default(uuid())
  partyId String   @map("party_id") @db.Uuid
  type    String
  value   String
  addedOn DateTime @default(now()) @map("added_on")
  details Json?
  party   Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("party_contact")
}

model PartyPaymentMethod {
  id      String   @id @default(uuid())
  partyId String   @map("party_id") @db.Uuid
  type    String
  value   String
  addedOn DateTime @default(now()) @map("added_on")
  details Json?
  party   Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("party_payment_method")
}

model AssetGroup {
  id                  String                  @id @default(uuid())
  name                String
  type                AccountType
  bankName            String?                 @map("bank_name")
  branch              String?
  accountType         String?                 @map("account_type")
  currency            String?
  accountId           String
  projectId           String                  @db.Uuid
  createdAt           DateTime                @default(now())
  account             Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  project             Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activityStock       ActivityStock[]
  transactionLines    TransactionLine[]
  accountTransactions FinAccountTransaction[]

  @@index([accountId])
  @@index([projectId])
  @@map("fin_book")
}

model FinAccount {
  id                String    @id @default(uuid())
  profile_id        String
  projectId         String    @db.Uuid
  name              String
  description       String?
  type              String
  currency          String
  is_multi_currency Boolean   @default(false)
  status            String
  notes             String?
  opened_on         DateTime?
  created_on        DateTime  @default(now())
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([profile_id])
  @@index([projectId])
  @@index([status])
  @@map("fin_account")
}

model Transaction {
  id                String            @id @default(uuid())
  organizationId    String            @map("organization_id")
  projectId         String            @db.Uuid
  transactionTypeId String            @map("transaction_type_id")
  title             String
  description       String?
  transactionDate   DateTime          @map("transaction_date")
  status            String
  referenceNumber   String?           @map("reference_number")
  externalReference String?           @map("external_reference")
  currency          String
  finalAmount       Decimal           @default(0) @map("final_amount")
  createdBy         String?           @map("created_by")
  createdAt         DateTime          @default(now()) @map("created_at")
  tags              Json?
  notes             Json?
  details           Json?
  organization      Account           @relation("TransactionOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lines             TransactionLine[]

  @@index([organizationId])
  @@index([projectId])
  @@index([createdBy])
  @@index([transactionDate])
  @@map("transaction")
}

model TransactionLine {
  id            String      @id @default(uuid())
  transactionId String      @map("transaction_id")
  lineTypeId    String?     @map("line_type_id")
  title         String
  description   String?
  referenceType String?     @map("reference_type")
  referenceId   String?     @map("reference_id")
  currency      String
  baseAmount    Decimal     @default(0) @map("base_amount")
  sortOrder     Int         @default(0) @map("sort_order")
  metadata      Json?
  finBook       String?     @map("fin_book")
  finAccount    String?     @map("fin_account")
  tags          Json?
  details       Json?
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  book          AssetGroup? @relation(fields: [finBook], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([referenceType, referenceId])
  @@index([finBook])
  @@index([finAccount])
  @@map("transaction_line")
}

model FinAccountTransaction {
  id           String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String?
  finAccountId String                      @map("fin_account_id")
  partyId      String?                     @map("party_id") @db.Uuid
  currency     String
  amount       Decimal                     @db.Decimal(18, 2)
  direction    String
  status       FinAccountTransactionStatus @default(active)
  tags         Json?                       @db.JsonB
  details      Json?                       @db.JsonB
  activityOn   DateTime                    @map("activity_on") @db.Timestamptz(3)
  finAccount   AssetGroup                  @relation(fields: [finAccountId], references: [id], onDelete: Cascade)
  party        Party?                      @relation(fields: [partyId], references: [id], onDelete: SetNull)

  @@index([finAccountId, activityOn])
  @@index([partyId])
  @@map("fin_accounts_transactions")
}

enum FinAccountTransactionStatus {
  draft
  active
  reviewRequired @map("reviewRequired")
}

model Projection {
  id          String               @id @default(uuid())
  title       String
  type        ProjectionType
  certainty   ProjectionCertainty
  amount      Decimal
  currency    String
  date        DateTime
  userId      String
  projectId   String               @db.Uuid
  status      ProjectionStatus
  recipient   String?
  isRecurring Boolean              @default(false)
  recurrence  ProjectionRecurrence
  endsOn      DateTime?
  createdAt   DateTime             @default(now())
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
}

enum AccountType {
  Bank
  Cash
  Investment
  Stock
  Other
}

model ActivityStock {
  id            String            @id @default(uuid())
  assetGroupId  String            @map("asset_group_id")
  stockName     String            @map("stock_name")
  activityType  ActivityStockType @map("activity_type")
  cost          Decimal
  balance       Decimal
  recordedOn    DateTime          @map("recorded_on")
  transactionOn DateTime          @map("transaction_on")
  assetGroup    AssetGroup        @relation(fields: [assetGroupId], references: [id], onDelete: Cascade)

  @@index([assetGroupId])
  @@index([recordedOn])
  @@map("activity_stock")
}

model Document {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String             @map("project_id") @db.Uuid
  type      String             @db.VarChar
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @default(now()) @updatedAt @map("updated_at")
  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quotation DocumentQuotation?
  invoice   Invoice?
  proforma  Proforma?

  @@index([projectId, type])
  @@map("documents")
}

model DocumentQuotation {
  id              String                        @id @db.Uuid
  customerId      String                        @map("customer_id") @db.Uuid
  counter         Int
  referenceNumber String                        @map("reference_number") @db.VarChar
  subject         String                        @db.VarChar
  currency        String                        @db.VarChar
  exchangeRate    Decimal                       @map("exchange_rate") @db.Decimal(18, 6)
  subtotal        Decimal                       @db.Decimal(18, 2)
  discountType    String                        @map("discount_type") @db.VarChar
  discountValue   Decimal                       @map("discount_value") @db.Decimal(18, 2)
  discountAmount  Decimal                       @map("discount_amount") @db.Decimal(18, 2)
  taxTotal        Decimal                       @map("tax_total") @db.Decimal(18, 2)
  hasAdjustments  Boolean                       @default(false) @map("has_adjustments")
  total           Decimal                       @db.Decimal(18, 2)
  status          String                        @db.VarChar
  date            DateTime                      @db.Date
  expires         DateTime                      @db.Date
  details         Json?
  createdAt       DateTime                      @default(now()) @map("created_at")
  updatedAt       DateTime                      @default(now()) @updatedAt @map("updated_at")
  document        Document                      @relation(fields: [id], references: [id], onDelete: Cascade)
  customer        Party                         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  adjustments     DocumentQuotationAdjustment[]
  items           DocumentAdjustmentItem[]

  @@index([customerId, date])
  @@map("documents_quotations")
}

model DocumentQuotationAdjustment {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationId     String            @map("quotation_id") @db.Uuid
  adjustmentName  String            @map("adjustment_name") @db.VarChar
  adjustmentValue Decimal           @map("adjustment_value") @db.Decimal(18, 2)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")
  quotation       DocumentQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("documents_quotations_adjustments")
}

model DocumentAdjustmentItem {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationId    String            @map("quotation_id") @db.Uuid
  productId      String?           @map("product_id") @db.Uuid
  name           String            @db.VarChar
  description    String?           @db.VarChar(128)
  quantity       Decimal           @db.Decimal(18, 2)
  unit           String            @db.VarChar
  rate           Decimal           @db.Decimal(18, 2)
  discountType   String            @map("discount_type") @db.VarChar
  discountValue  Decimal           @map("discount_value") @db.Decimal(18, 2)
  discountAmount Decimal           @map("discount_amount") @db.Decimal(18, 2)
  taxRate        Decimal           @map("tax_rate") @db.Decimal(8, 4)
  taxAmount      Decimal           @map("tax_amount") @db.Decimal(18, 2)
  amount         Decimal           @db.Decimal(18, 2)
  sortIndex      Int               @map("sort_index")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at")
  quotation      DocumentQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId, sortIndex])
  @@map("documents_adjustments_items")
}

model Invoice {
  id              String              @id @db.Uuid
  customerId      String              @map("customer_id") @db.Uuid
  counter         Int
  referenceNumber String              @map("reference_number") @db.VarChar
  subject         String              @db.VarChar
  currency        String              @db.VarChar
  exchangeRate    Decimal             @map("exchange_rate") @db.Decimal(18, 6)
  subtotal        Decimal             @db.Decimal(18, 2)
  discountType    String              @map("discount_type") @db.VarChar
  discountValue   Decimal             @map("discount_value") @db.Decimal(18, 2)
  discountAmount  Decimal             @map("discount_amount") @db.Decimal(18, 2)
  taxTotal        Decimal             @map("tax_total") @db.Decimal(18, 2)
  hasAdjustments  Boolean             @default(false) @map("has_adjustments")
  total           Decimal             @db.Decimal(18, 2)
  status          String              @db.VarChar
  date            DateTime            @db.Date
  dueDate         DateTime            @map("due_date") @db.Date
  details         Json?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at")
  document        Document            @relation(fields: [id], references: [id], onDelete: Cascade)
  customer        Party               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  adjustments     InvoiceAdjustment[]
  items           InvoiceItem[]

  @@index([customerId, date])
  @@map("documents_invoices")
}

model InvoiceAdjustment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId       String   @map("invoice_id") @db.Uuid
  adjustmentName  String   @map("adjustment_name") @db.VarChar
  adjustmentValue Decimal  @map("adjustment_value") @db.Decimal(18, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("documents_invoices_adjustments")
}

model InvoiceItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  name           String   @db.VarChar
  description    String?  @db.VarChar(128)
  quantity       Decimal  @db.Decimal(18, 2)
  unit           String   @db.VarChar
  rate           Decimal  @db.Decimal(18, 2)
  discountType   String   @map("discount_type") @db.VarChar
  discountValue  Decimal  @map("discount_value") @db.Decimal(18, 2)
  discountAmount Decimal  @map("discount_amount") @db.Decimal(18, 2)
  taxRate        Decimal  @map("tax_rate") @db.Decimal(8, 4)
  taxAmount      Decimal  @map("tax_amount") @db.Decimal(18, 2)
  amount         Decimal  @db.Decimal(18, 2)
  sortIndex      Int      @map("sort_index")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, sortIndex])
  @@map("documents_invoices_items")
}

model Proforma {
  id              String               @id @db.Uuid
  customerId      String               @map("customer_id") @db.Uuid
  counter         Int
  referenceNumber String               @map("reference_number") @db.VarChar
  subject         String               @db.VarChar
  currency        String               @db.VarChar
  exchangeRate    Decimal              @map("exchange_rate") @db.Decimal(18, 6)
  subtotal        Decimal              @db.Decimal(18, 2)
  discountType    String               @map("discount_type") @db.VarChar
  discountValue   Decimal              @map("discount_value") @db.Decimal(18, 2)
  discountAmount  Decimal              @map("discount_amount") @db.Decimal(18, 2)
  taxTotal        Decimal              @map("tax_total") @db.Decimal(18, 2)
  hasAdjustments  Boolean              @default(false) @map("has_adjustments")
  total           Decimal              @db.Decimal(18, 2)
  status          String               @db.VarChar
  date            DateTime             @db.Date
  dueDate         DateTime             @map("due_date") @db.Date
  details         Json?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at")
  document        Document             @relation(fields: [id], references: [id], onDelete: Cascade)
  customer        Party                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  adjustments     ProformaAdjustment[]
  items           ProformaItem[]

  @@index([customerId, date])
  @@map("documents_proformas")
}

model ProformaAdjustment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proformaId      String   @map("proforma_id") @db.Uuid
  adjustmentName  String   @map("adjustment_name") @db.VarChar
  adjustmentValue Decimal  @map("adjustment_value") @db.Decimal(18, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  proforma        Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@index([proformaId])
  @@map("documents_proformas_adjustments")
}

model ProformaItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proformaId     String   @map("proforma_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  name           String   @db.VarChar
  description    String?  @db.VarChar(128)
  quantity       Decimal  @db.Decimal(18, 2)
  unit           String   @db.VarChar
  rate           Decimal  @db.Decimal(18, 2)
  discountType   String   @map("discount_type") @db.VarChar
  discountValue  Decimal  @map("discount_value") @db.Decimal(18, 2)
  discountAmount Decimal  @map("discount_amount") @db.Decimal(18, 2)
  taxRate        Decimal  @map("tax_rate") @db.Decimal(8, 4)
  taxAmount      Decimal  @map("tax_amount") @db.Decimal(18, 2)
  amount         Decimal  @db.Decimal(18, 2)
  sortIndex      Int      @map("sort_index")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  proforma       Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@index([proformaId, sortIndex])
  @@map("documents_proformas_items")
}

enum ProjectionType {
  Income
  Expense
}

enum ProjectionCertainty {
  Fixed
  Probable
  Possible
}

enum ProjectionStatus {
  Active
  Canceled
}

enum ProjectionRecurrence {
  Once
  Daily
  Weekly
  Monthly
  Yearly
  Custom
}

enum ActivityStockType {
  purchase_in
  sale_out
  transfer_in
  transfer_out
  dividend_in
  calculation
}
