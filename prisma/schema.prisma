generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id
  displayName  String
  accountId    String
  email        String?       @unique
  createdAt    DateTime      @default(now())
  projections  Projection[]
  transactions Transaction[]
}

model Account {
  id             String   @id
  connection_id  String   @unique
  displayName    String   @default("")
  neupid         String   @default("")
  displayImage   String   @default("")
  ledgers        Ledger[]

  @@map("accounts")
}

model Ledger {
  id        String      @id @default(uuid())
  name      String
  type      AccountType
  balance   Decimal     @default(0)
  currency  String
  accountId String
  createdAt DateTime    @default(now())
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([accountId])
  @@map("ledgers")
}

model Transaction {
  id                 String            @id @default(uuid())
  title              String
  description        String?
  accountId          String
  ledgerId           String
  category           String
  transaction_type   TransactionType
  total_amount       Decimal
  total_paid         Decimal           @default(0)
  balance_due        Decimal           @default(0)
  status             TransactionStatus
  date               DateTime
  currency           String
  recipient          String?
  due_on             DateTime?
  reference_document String?
  created_at         DateTime          @default(now())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger             Ledger            @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  lines              TransactionLine[]

  @@index([userId])
  @@index([ledgerId])
  @@index([date])
}

model TransactionLine {
  id            String                  @id @default(uuid())
  transactionId String
  line_title    String
  description   String?
  category      TransactionLineCategory
  account       String
  debit         Decimal                 @default(0)
  credit        Decimal                 @default(0)
  currency      String
  transaction   Transaction             @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model Projection {
  id          String               @id @default(uuid())
  title       String
  type        ProjectionType
  certainty   ProjectionCertainty
  amount      Decimal
  currency    String
  date        DateTime
  userId      String
  status      ProjectionStatus
  recipient   String?
  isRecurring Boolean              @default(false)
  recurrence  ProjectionRecurrence
  endsOn      DateTime?
  createdAt   DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AccountType {
  Bank
  Cash
  Investment
  Other
}

enum TransactionStatus {
  unpaid
  partially_paid
  paid
  canceled
}

enum TransactionType {
  sale
  purchase
  refund
  expense
  payroll
  income
  other
}

enum ProjectionType {
  Income
  Expense
}

enum ProjectionCertainty {
  Fixed
  Probable
  Possible
}

enum ProjectionStatus {
  Active
  Canceled
}

enum ProjectionRecurrence {
  Once
  Daily
  Weekly
  Monthly
  Yearly
  Custom
}

enum TransactionLineCategory {
  vat_paid
  vat_return
  sales
  referral_paid
  payable
  receivable
}
