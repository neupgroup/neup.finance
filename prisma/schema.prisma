generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  Bank
  Cash
  Investment
  Other
}

enum TransactionStatus {
  unpaid
  partially_paid
  paid
  canceled
}

enum TransactionType {
  sale
  purchase
  refund
  expense
  payroll
  income
  other
}

enum ProjectionType {
  Income
  Expense
}

enum ProjectionCertainty {
  Fixed
  Probable
  Possible
}

enum ProjectionStatus {
  Active
  Canceled
}

enum ProjectionRecurrence {
  Once
  Daily
  Weekly
  Monthly
  Yearly
  Custom
}

enum TransactionLineCategory {
  vat_paid
  vat_return
  sales
  referral_paid
  payable
  receivable
}

model User {
  id          String   @id
  displayName String
  accountId   String   @unique
  email       String?  @unique
  createdAt   DateTime @default(now())

  accounts     Account[]
  transactions Transaction[]
  projections  Projection[]
}

model Account {
  id        String      @id @default(uuid())
  name      String
  type      AccountType
  balance   Decimal     @default(0)
  currency  String
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@index([userId])
}

model Transaction {
  id               String             @id @default(uuid())
  title            String
  description      String?
  accountId        String
  category         String
  transaction_type TransactionType
  total_amount     Decimal
  total_paid       Decimal            @default(0)
  balance_due      Decimal            @default(0)
  status           TransactionStatus
  date             DateTime
  currency         String
  recipient        String?
  due_on           DateTime?
  reference_document String?
  created_at       DateTime           @default(now())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines            TransactionLine[]

  @@index([userId])
  @@index([date])
}

model TransactionLine {
  id             String                    @id @default(uuid())
  transactionId  String
  transaction    Transaction                @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  line_title     String
  description    String?
  category       TransactionLineCategory
  account        String
  debit          Decimal                    @default(0)
  credit         Decimal                    @default(0)
  currency       String

  @@index([transactionId])
}

model Projection {
  id         String              @id @default(uuid())
  title      String
  type       ProjectionType
  certainty  ProjectionCertainty
  amount     Decimal
  currency   String
  date       DateTime
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     ProjectionStatus
  recipient  String?
  isRecurring Boolean            @default(false)
  recurrence ProjectionRecurrence
  endsOn     DateTime?
  createdAt  DateTime            @default(now())

  @@index([userId])
}

