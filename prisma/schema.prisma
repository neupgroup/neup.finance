generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String        @id
  displayName         String
  accountId           String
  email               String?       @unique
  createdAt           DateTime      @default(now())
  projections         Projection[]
  createdTransactions Transaction[] @relation("TransactionCreatedBy")
}

model Account {
  id                       String        @id
  connection_id            String        @unique
  displayName              String        @default("")
  neupid                   String        @default("")
  displayImage             String        @default("")
  assetGroups              AssetGroup[]
  parties                  Party[]
  organizationTransactions Transaction[] @relation("TransactionOrganization")

  @@map("accounts")
}

model Party {
  id        String           @id @default(uuid())
  accountId String           @map("account_id")
  name      String
  type      String
  taxinfo   Json?
  account   Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contacts  PartyContact[]
  paymentMethods PartyPaymentMethod[]

  @@index([accountId])
  @@map("party")
}

model PartyContact {
  id       String   @id @default(uuid())
  partyId  String   @map("party_id")
  type     String
  value    String
  addedOn  DateTime @default(now()) @map("added_on")
  details  Json?
  party    Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("party_contact")
}

model PartyPaymentMethod {
  id       String   @id @default(uuid())
  partyId  String   @map("party_id")
  type     String
  value    String
  addedOn  DateTime @default(now()) @map("added_on")
  details  Json?
  party    Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("party_payment_method")
}

model AssetGroup {
  id        String      @id @default(uuid())
  name      String
  type      AccountType
  currency  String
  accountId String
  createdAt DateTime    @default(now())
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  activityStock ActivityStock[]
  transactionLines TransactionLine[]

  @@index([accountId])
  @@map("book")
}

model Transaction {
  id                String            @id @default(uuid())
  organizationId    String            @map("organization_id")
  transactionTypeId String            @map("transaction_type_id")
  title             String
  description       String?
  transactionDate   DateTime          @map("transaction_date")
  status            String
  referenceNumber   String?           @map("reference_number")
  externalReference String?           @map("external_reference")
  currency          String
  finalAmount       Decimal           @default(0) @map("final_amount")
  createdBy         String?           @map("created_by")
  createdAt         DateTime          @default(now()) @map("created_at")
  tags              Json?
  notes             Json?
  details           Json?
  organization      Account           @relation("TransactionOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  creator           User?             @relation("TransactionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  lines             TransactionLine[]

  @@index([organizationId])
  @@index([createdBy])
  @@index([transactionDate])
  @@map("transaction")
}

model TransactionLine {
  id            String       @id @default(uuid())
  transactionId String       @map("transaction_id")
  lineTypeId    String?      @map("line_type_id")
  title         String
  description   String?
  referenceType String?      @map("reference_type")
  referenceId   String?      @map("reference_id")
  currency      String
  baseAmount    Decimal      @default(0) @map("base_amount")
  sortOrder     Int          @default(0) @map("sort_order")
  metadata      Json?
  finBook       String?      @map("fin_book")
  finAccount    String?      @map("fin_account")
  tags          Json?
  details       Json?
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  book          AssetGroup?  @relation(fields: [finBook], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([referenceType, referenceId])
  @@index([finBook])
  @@map("transaction_line")
}

model Projection {
  id          String               @id @default(uuid())
  title       String
  type        ProjectionType
  certainty   ProjectionCertainty
  amount      Decimal
  currency    String
  date        DateTime
  userId      String
  status      ProjectionStatus
  recipient   String?
  isRecurring Boolean              @default(false)
  recurrence  ProjectionRecurrence
  endsOn      DateTime?
  createdAt   DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AccountType {
  Bank
  Cash
  Investment
  Stock
  Other
}

model ActivityStock {
  id            String             @id @default(uuid())
  assetGroupId   String             @map("asset_group_id")
  stockName     String             @map("stock_name")
  activityType  ActivityStockType  @map("activity_type")
  cost          Decimal
  balance       Decimal
  recordedOn    DateTime           @map("recorded_on")
  transactionOn DateTime           @map("transaction_on")
  assetGroup    AssetGroup         @relation(fields: [assetGroupId], references: [id], onDelete: Cascade)

  @@index([assetGroupId])
  @@index([recordedOn])
  @@map("activity_stock")
}

enum ProjectionType {
  Income
  Expense
}

enum ProjectionCertainty {
  Fixed
  Probable
  Possible
}

enum ProjectionStatus {
  Active
  Canceled
}

enum ProjectionRecurrence {
  Once
  Daily
  Weekly
  Monthly
  Yearly
  Custom
}

enum ActivityStockType {
  purchase_in
  sale_out
  transfer_in
  transfer_out
  dividend_in
  calculation
}
