generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id
  displayName  String
  accountId    String
  email        String?       @unique
  createdAt    DateTime      @default(now())
  projections  Projection[]
  transactions Transaction[]
}

model Account {
  id             String   @id
  connection_id  String   @unique
  displayName    String   @default("")
  neupid         String   @default("")
  displayImage   String   @default("")
  assetGroups    AssetGroup[]

  @@map("accounts")
}

model AssetGroup {
  id        String      @id @default(uuid())
  name      String
  type      AccountType
  currency  String
  accountId String
  createdAt DateTime    @default(now())
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  activityStock ActivityStock[]
  transactions Transaction[]

  @@index([accountId])
  @@map("asset_group")
}

model Transaction {
  id                 String            @id @default(uuid())
  title              String
  description        String?
  accountId          String
  assetGroupId       String
  category           String
  transaction_type   TransactionType
  total_amount       Decimal
  total_paid         Decimal           @default(0)
  balance_due        Decimal           @default(0)
  status             TransactionStatus
  date               DateTime
  currency           String
  recipient          String?
  due_on             DateTime?
  reference_document String?
  created_at         DateTime          @default(now())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetGroup         AssetGroup        @relation(fields: [assetGroupId], references: [id], onDelete: Cascade)
  lines              TransactionLine[]

  @@index([userId])
  @@index([assetGroupId])
  @@index([date])
}

model TransactionLine {
  id            String                  @id @default(uuid())
  transactionId String
  line_title    String
  description   String?
  category      TransactionLineCategory
  account       String
  debit         Decimal                 @default(0)
  credit        Decimal                 @default(0)
  currency      String
  transaction   Transaction             @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model Projection {
  id          String               @id @default(uuid())
  title       String
  type        ProjectionType
  certainty   ProjectionCertainty
  amount      Decimal
  currency    String
  date        DateTime
  userId      String
  status      ProjectionStatus
  recipient   String?
  isRecurring Boolean              @default(false)
  recurrence  ProjectionRecurrence
  endsOn      DateTime?
  createdAt   DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AccountType {
  Bank
  Cash
  Investment
  Stock
  Other
}

model ActivityStock {
  id            String             @id @default(uuid())
  assetGroupId   String             @map("asset_group_id")
  stockName     String             @map("stock_name")
  activityType  ActivityStockType  @map("activity_type")
  cost          Decimal
  balance       Decimal
  recordedOn    DateTime           @map("recorded_on")
  transactionOn DateTime           @map("transaction_on")
  assetGroup    AssetGroup         @relation(fields: [assetGroupId], references: [id], onDelete: Cascade)

  @@index([assetGroupId])
  @@index([recordedOn])
  @@map("activity_stock")
}

enum TransactionStatus {
  unpaid
  partially_paid
  paid
  canceled
}

enum TransactionType {
  sale
  purchase
  refund
  expense
  payroll
  income
  other
}

enum ProjectionType {
  Income
  Expense
}

enum ProjectionCertainty {
  Fixed
  Probable
  Possible
}

enum ProjectionStatus {
  Active
  Canceled
}

enum ProjectionRecurrence {
  Once
  Daily
  Weekly
  Monthly
  Yearly
  Custom
}

enum TransactionLineCategory {
  vat_paid
  vat_return
  sales
  referral_paid
  payable
  receivable
}

enum ActivityStockType {
  purchase_in
  sale_out
  transfer_in
  transfer_out
  dividend_in
  calculation
}
